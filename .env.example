# ---------- Base de données ----------
# SQLite par défaut (prototype). Pour PostgreSQL :
# DATABASE_URL=postgresql+psycopg2://meetmind:motdepasse@localhost:5432/meetmind
DATABASE_URL=sqlite:///./meetmind.db

# ---------- Modèles NLP ----------
# Mode : "auto" (utilise les modèles s'ils sont installés, sinon fallback),
#        "light" (fallbacks uniquement, rapide), "full" (exige les modèles)
NLP_MODE=auto

WHISPER_MODEL=small
# Mots toujours donnés à Whisper (noms de l'équipe, termes techniques)
WHISPER_PROMPT=MeetMind, BARThez, CamemBERT, Whisper, encadrant, soutenance
# Résumé : "barthez" | "mt5" | "bart" | "llm" | "extractive"
SUMMARIZER=barthez
SUMMARIZER_MODEL=moussaKam/barthez-orangesum-abstract
# Option LLM (via Ollama en local : confidentialité des données)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
SPACY_MODEL=fr_core_news_lg
# Chemin du CamemBERT fine-tuné (produit par training/train_classifier.py)
CLASSIFIER_MODEL_PATH=./models/camembert-meetmind
SBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Diarisation audio (qui parle ?) — pyannote, nécessite un token Hugging Face
DIARIZATION=off
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# ---------- E-mail (export) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Frontend ----------
API_URL=http://localhost:8000
